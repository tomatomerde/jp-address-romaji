{
  "name": "jp-address-romaji",
  "version": "0.1.6",
  "description": "Bidirectional conversion between Japanese and romanized (international) addresses. Runs fully offline: address data never leaves your machine.",
  "keywords": [
    "japan",
    "japanese",
    "address",
    "romaji",
    "hepburn",
    "romanization",
    "i18n",
    "shipping",
    "postal-code",
    "offline"
  ],
  "license": "MIT",
  "author": "tomatomerde",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "browser": {
        "types": "./dist/index.browser.d.ts",
        "default": "./dist/index.browser.js"
      },
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "browser": {
    "./dist/index.js": "./dist/index.browser.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@geolonia/normalize-japanese-addresses": "^3.1.3"
  },
  "peerDependencies": {
    "jp-address-romaji-data": "^0.1.0-0"
  },
  "peerDependenciesMeta": {
    "jp-address-romaji-data": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tomatomerde/jp-address-romaji.git",
    "directory": "packages/core"
  },
  "homepage": "https://tomatomerde.github.io/jp-address-romaji/",
  "bugs": {
    "url": "https://github.com/tomatomerde/jp-address-romaji/issues"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "jp-address-romaji-data": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  }
}
