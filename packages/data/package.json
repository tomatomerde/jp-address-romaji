{
  "name": "jp-address-romaji-data",
  "version": "0.1.4",
  "description": "Offline Japanese address dataset for jp-address-romaji, derived from the Digital Agency Address Base Registry via Geolonia.",
  "keywords": [
    "japan",
    "japanese",
    "address",
    "dataset",
    "offline",
    "address-base-registry",
    "geolonia",
    "municipalities",
    "open-data",
    "i18n"
  ],
  "license": "MIT",
  "author": "tomatomerde",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "jp-address-romaji-data": "./dist/cli.js"
  },
  "files": [
    "dist",
    "data",
    "README.md",
    "ATTRIBUTION.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build:data": "tsx src/build-data.ts",
    "check:publishable": "node scripts/check-publishable.mjs",
    "prepublishOnly": "pnpm run build && pnpm run check:publishable"
  },
  "devDependencies": {
    "@types/node": "^22.10.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tomatomerde/jp-address-romaji.git",
    "directory": "packages/data"
  },
  "homepage": "https://github.com/tomatomerde/jp-address-romaji#readme",
  "bugs": {
    "url": "https://github.com/tomatomerde/jp-address-romaji/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
