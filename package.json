{
  "name": "jp-address-romaji-monorepo",
  "private": true,
  "type": "module",
  "description": "Monorepo for jp-address-romaji: bidirectional Japanese/romaji address conversion.",
  "scripts": {
    "build": "pnpm -r build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r typecheck && tsc -p tsconfig.tests.json",
    "lint": "eslint .",
    "coverage:measure": "tsx scripts/measure-coverage.ts"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.10.0",
    "esbuild": "^0.25.0",
    "eslint": "^10.8.1",
    "globals": "^17.11.0",
    "playwright": "1.56.1",
    "tsx": "^4.23.12",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.67.0",
    "vitest": "^2.1.8"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=18"
  }
}
